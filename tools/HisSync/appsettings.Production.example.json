// HIS Sync worker: server settings. Copy this file to appsettings.Production.json in the IIS folder of the
// /his-sync application, fill in the <...> values, and give only the app pool identity read access to it.
// The package never contains appsettings.Production.json, so a redeploy leaves it in place.
// Comments are allowed in this file (ASP.NET Core skips them). Never commit the filled-in copy.
{
  "ConnectionStrings": {
    // The VERITA database, the same one the API uses. db_datareader + db_datawriter is enough: the worker
    // never changes the schema. It takes a lock with sp_getapplock (allowed for any database user).
    "Verita": "Server=<VERITA-SQL-SERVER>;Database=Verita;User Id=<verita-login>;Password=<password>;TrustServerCertificate=True;Encrypt=True;Application Name=VeritaHisSync"
  },

  "His": {
    // HISGENX, read-only. The login must be able to create #temp tables (any login can) and read PHARMAKON.
    "ConnectionString": "Server=RAY-VIDA-UAT;Database=HISGENX;User Id=<his-read-only-login>;Password=<password>;TrustServerCertificate=True;Encrypt=True;Application Name=VeritaHisSync",
    // Per tenant, keyed SetupID-ProjectID as on the hospital: SWD-AGL is 010266-17. Only needed when a tenant's
    // HIS is on another server than ConnectionString above (or uses another pharmacy database); otherwise leave it out.
    "Tenants": {
      // "010266-17": { "ConnectionString": "Server=RAY-VIDA-UAT;Database=HISGENX;User Id=<his-read-only-login>;Password=<password>;TrustServerCertificate=True;Encrypt=True;Application Name=VeritaHisSync", "PharmacyDb": "PHARMAKON" }
    },
    "PharmacyDb": "PHARMAKON",
    "QueryTimeoutSeconds": 1800,
    "Claims": false
  },

  "HisSync": {
    "Enabled": true,
    // First rollout: catalogue only, for one hospital. Turn facts on after batchcheck matches on UAT
    // (tools/HisSync/README.md), then widen Hospitals, or empty it to sync every HIS-linked hospital.
    "CatalogueEnabled": true,
    "FactsEnabled": false,
    "Hospitals": [ "SWD-AGL" ],

    "BatchSize": 100,
    "PauseBetweenBatchesMs": 2000,
    "PollSeconds": 30,
    "MaxAttempts": 3,
    "UtcOffsetHours": 3,

    // Where packs are written while they are imported (deleted after each) and where an interrupted catalogue check
    // keeps its checkpoint to resume from. The app pool identity needs modify rights here; use a folder nothing cleans.
    "WorkDir": "D:\\verita\\his-sync-work",
    "CatalogueRetryMinutes": 5,
    // One VERITA query's limit for the worker (catalogue dry-runs and imports can take longer than an API request).
    "VeritaCommandTimeoutSeconds": 1800,

    // When set, GET /status needs the header X-Sync-Key with this value. Use a long random string.
    "StatusKey": "<long-random-value>"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
